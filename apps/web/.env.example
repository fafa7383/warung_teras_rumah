# Salin menjadi apps/web/.env.local lalu sesuaikan.

# URL API Express. Lokal: http://localhost:4000 · Produksi: alamat API di Render
NEXT_PUBLIC_API_URL=http://localhost:4000

# Produksi saja (kosongkan di lokal): alamat API yang sama. Dipakai server web untuk SSR dan
# meneruskan /api/admin dari domain web ke API, agar cookie login admin tetap first-party.
API_URL_INTERNAL=

# Nilai di bawah adalah kunci tes resmi Cloudflare Turnstile (selalu lolos), khusus lokal.
# Produksi: buat widget di dashboard Cloudflare > Turnstile (mode Managed) untuk domain web.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
