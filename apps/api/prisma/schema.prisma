// Skema database Warung Teras Rumah (PRD 10.4).
// - Semua uang disimpan sebagai integer rupiah.
// - Semua waktu disimpan UTC (timestamptz) dan ditampilkan dalam Asia/Jakarta.
// - Nilai enum harus sama dengan packages/shared/src/enums.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  DINE_IN
  DELIVERY
}

enum PaymentMethod {
  CASH
  QRIS
}

enum OrderStatus {
  AWAITING_PAYMENT
  AWAITING_CONFIRMATION
  CONFIRMED
  PROCESSING
  DELIVERING
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum StatusActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum OptionGroupType {
  SINGLE
  MULTIPLE
}

enum BannerTargetType {
  NONE
  CATEGORY
  MENU
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  /// Dinaikkan saat ganti password agar sesi lama otomatis tidak berlaku.
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_users")
}

/// Satu baris saja (id = 1).
model StoreSetting {
  id               Int       @id @default(1)
  name             String    @db.VarChar(60)
  address          String    @default("") @db.VarChar(200)
  /// Nomor WA warung, format 62…
  whatsapp         String    @default("") @db.VarChar(16)
  logoUrl          String?   @map("logo_url")
  qrisImageUrl     String?   @map("qris_image_url")
  qrisMerchantName String?   @map("qris_merchant_name") @db.VarChar(60)
  isManuallyClosed Boolean   @default(false) @map("is_manually_closed")
  closedUntil      DateTime? @map("closed_until") @db.Timestamptz(3)
  closedMessage    String?   @map("closed_message") @db.VarChar(200)
  soundRepeat      Boolean   @default(true) @map("sound_repeat")
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}

/// 7 baris, day_of_week 0 = Minggu … 6 = Sabtu. Jam dalam WIB, format "HH:mm".
model OperatingHour {
  dayOfWeek Int     @id @map("day_of_week") @db.SmallInt
  isOpen    Boolean @default(true) @map("is_open")
  openTime  String  @map("open_time") @db.VarChar(5)
  closeTime String  @map("close_time") @db.VarChar(5)

  @@map("operating_hours")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(40)
  slug      String     @unique @db.VarChar(60)
  /// Kunci ilustrasi ikon di web, mis. "bakso".
  icon      String     @db.VarChar(40)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  name          String        @db.VarChar(50)
  slug          String        @unique @db.VarChar(80)
  description   String?       @db.VarChar(120)
  basePrice     Int           @map("base_price")
  imageUrl      String?       @map("image_url")
  isAvailable   Boolean       @default(true) @map("is_available")
  isFavorite    Boolean       @default(false) @map("is_favorite")
  isRecommended Boolean       @default(false) @map("is_recommended")
  sortOrder     Int           @default(0) @map("sort_order")
  /// Soft delete agar laporan lama tetap benar.
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups  OptionGroup[]
  orderItems    OrderItem[]

  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

model OptionGroup {
  id         String          @id @default(uuid()) @db.Uuid
  menuItemId String          @map("menu_item_id") @db.Uuid
  name       String          @db.VarChar(40)
  type       OptionGroupType
  isRequired Boolean         @default(false) @map("is_required")
  /// Hanya untuk MULTIPLE; null = tanpa batas.
  maxSelect  Int?            @map("max_select")
  sortOrder  Int             @default(0) @map("sort_order")
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options    Option[]

  @@index([menuItemId, sortOrder])
  @@map("option_groups")
}

model Option {
  id            String      @id @default(uuid()) @db.Uuid
  optionGroupId String      @map("option_group_id") @db.Uuid
  name          String      @db.VarChar(40)
  priceDelta    Int         @default(0) @map("price_delta")
  isDefault     Boolean     @default(false) @map("is_default")
  isActive      Boolean     @default(true) @map("is_active")
  sortOrder     Int         @default(0) @map("sort_order")
  group         OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId, sortOrder])
  @@map("options")
}

model Order {
  id                     String           @id @default(uuid()) @db.Uuid
  /// WTR-XXXXX
  code                   String           @unique @db.VarChar(12)
  /// 24 byte acak (base64url); satu-satunya kunci untuk membuka detail pesanan.
  accessToken            String           @unique @map("access_token") @db.VarChar(64)
  orderType              OrderType        @map("order_type")
  paymentMethod          PaymentMethod    @map("payment_method")
  status                 OrderStatus
  customerName           String           @map("customer_name") @db.VarChar(50)
  /// Dinormalisasi ke format 62…
  customerPhone          String           @map("customer_phone") @db.VarChar(16)
  address                String?          @db.VarChar(200)
  landmark               String?          @db.VarChar(100)
  subtotal               Int
  deliveryFee            Int              @default(0) @map("delivery_fee")
  total                  Int
  paymentDeadline        DateTime?        @map("payment_deadline") @db.Timestamptz(3)
  /// Path di bucket privat, bukan URL publik.
  paymentProofPath       String?          @map("payment_proof_path")
  paymentProofUploadedAt DateTime?        @map("payment_proof_uploaded_at") @db.Timestamptz(3)
  rejectionReason        String?          @map("rejection_reason") @db.VarChar(200)
  ipHash                 String?          @map("ip_hash") @db.VarChar(64)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  items                  OrderItem[]
  statusLogs             OrderStatusLog[]

  @@index([status, createdAt])
  @@index([status, paymentDeadline])
  @@index([customerPhone, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// Snapshot nama, harga, dan opsi agar perubahan menu tidak mengubah pesanan lama.
model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  menuItemId        String   @map("menu_item_id") @db.Uuid
  nameSnapshot      String   @map("name_snapshot") @db.VarChar(50)
  basePriceSnapshot Int      @map("base_price_snapshot")
  /// OptionSnapshot[] dari @wtr/shared: grup, opsi, price_delta.
  optionsSnapshot   Json     @default("[]") @map("options_snapshot")
  unitPrice         Int      @map("unit_price")
  quantity          Int
  lineTotal         Int      @map("line_total")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderStatusLog {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actor      StatusActor
  note       String?      @db.VarChar(200)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model Banner {
  id         String           @id @default(uuid()) @db.Uuid
  imageUrl   String           @map("image_url")
  title      String           @db.VarChar(60)
  targetType BannerTargetType @default(NONE) @map("target_type")
  /// id kategori atau menu, sesuai target_type.
  targetId   String?          @map("target_id") @db.Uuid
  isActive   Boolean          @default(true) @map("is_active")
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("banners")
}

/// HP pemilik yang menerima Web Push.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("push_subscriptions")
}
