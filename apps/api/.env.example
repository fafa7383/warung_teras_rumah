# Salin menjadi apps/api/.env lalu isi. Jangan commit file .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Asal web yang boleh memanggil API (CORS + cek Origin admin). Pisahkan dengan koma bila lebih dari satu.
WEB_ORIGIN=http://localhost:3000
# Kosongkan di lokal. Produksi: .warungterasrumah.com (agar cookie admin berlaku di web & api).
COOKIE_DOMAIN=

# --- Database (Supabase Postgres) ---
# Supabase > tombol "Connect" > Session pooler (port 5432, mendukung IPv4).
# Ganti [PASSWORD] dengan password database; karakter khusus harus di-URL-encode.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"
# Dipakai Prisma CLI (migrate, studio). Boleh sama dengan DATABASE_URL.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"

# --- Auth admin ---
# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Akun pemilik dibuat oleh `pnpm db:seed` (password minimal 10 karakter).
ADMIN_SEED_USERNAME=pemilik
ADMIN_SEED_PASSWORD=

# --- Supabase Storage ---
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Supabase > Project Settings > API Keys: service_role key atau secret key (sb_secret_...). Rahasia, hanya di server.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PUBLIC_BUCKET=public-assets
STORAGE_PRIVATE_BUCKET=payment-proofs

# --- Cloudflare Turnstile ---
# Nilai di bawah adalah kunci tes resmi Cloudflare (selalu lolos), khusus lokal. Ganti kunci asli di produksi.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Web Push (VAPID) ---
# Buat dengan: pnpm vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pemilik@warungterasrumah.com

# --- Fase 2 (opsional): WhatsApp otomatis ke pemilik lewat gateway ---
WA_GATEWAY_TOKEN=
